# ============================================
# Netchi Sentinel — Environment Variables
# ============================================

# HIBP (Have I Been Pwned) BreachedAccount API Key
# Opsional. Jika di-set → cek email pakai API real HIBP.
# Jika kosong → fallback ke mock data (tetap bisa demo tanpa internet).
# Dapatkan key: https://haveibeenpwned.com/Subscription (Core 1, $4.39/bln)
# Untuk Vercel: tambah di Settings > Environment Variables.
# HIBP_API_KEY=your_32_character_hex_key_here

# EmailRep (email.io) API Key — GRATIS, untuk cek email real
# Daftar free key: https://emailrep.io/free (rolling 24h window, rate-limited)
# Wajib set kalau mau email user dicek terhadap database kebocoran real.
# EMAILREP_API_KEY=your_free_key_here
